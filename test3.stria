use print
use getEnv
use random

val x = 42
val y = 3.14
val message = "Hello, World!"
val result = x + 10
val product = x * 2
val quotient = x / 2
val remainder = x % 5

print("Basic arithmetic:")
print(result)
print(product)
print(quotient)
print(remainder)

print("Boolean operations:")
val isGreater = x > 30
val isEqual = x == 42
val combined = isGreater && isEqual
print(isGreater)
print(isEqual)
print(combined)

print("String operations:")
val greeting = "Hello, " + "World!"
print(greeting)

print("Random number:")
val rand = random()
print(rand)

print("Environment variable (PATH):")
val path = getEnv("PATH")
print(path)
